+// Straight-line distance in km (haversine); the chat advisor's engine uses the same formula.
+export function distanceKm(lat1, lon1, lat2, lon2) {
+  const rad = (d) => (d * Math.PI) / 180;
+  const a = Math.sin((rad(lat2) - rad(lat1)) / 2) ** 2 + Math.cos(rad(lat1)) * Math.cos(rad(lat2)) * Math.sin(rad(lon2 - lon1) / 2) ** 2;
+  return 6371.0088 * 2 * Math.asin(Math.sqrt(a));
+}
